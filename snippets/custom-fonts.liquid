{% style %}
  /* font-display: swap added on all faces — eliminates FOIT (invisible
     text while font loads), text shows in fallback then swaps in.
     Reduces LCP for text-heavy pages and stops worst-case font-blocked
     paint on slow networks. May cause minor FOUT (visible swap),
     considered acceptable trade-off for HairMNL's product pages. */
  @font-face {
    font-family: 'GeosansLight';
    font-style: normal;
    font-weight: normal;
    font-display: swap;
    src: local('GeosansLight'), url('{{ "GeosansLight.woff" | asset_url }}') format('woff');
  }

  @font-face {
    font-family: 'GeosansLight-Oblique';
    font-style: normal;
    font-weight: normal;
    font-display: swap;
    src: local('GeosansLight-Oblique'), url('{{ "GeosansLight-Oblique.woff" | asset_url }}') format('woff');
  }

  @font-face {
    font-family: 'SelfModern';
    font-style: normal;
    font-weight: normal;
    font-display: swap;
    {%- comment -%} bd v9o3: the file is a real woff2 (magic bytes wOF2, verified
      against the live CDN copy) but declared format('woff'). Chrome sniffs the
      bytes so it worked, but the hint was wrong and a stricter engine could skip
      the source entirely. This URL already matches theme.liquid's preload. {%- endcomment -%}
    src: local('SelfModern'), url('{{ "SelfModern.woff2" | asset_url }}') format('woff2');
  }

  @font-face {
    font-family: 'SelfModernItalic';
    font-style: normal;
    font-weight: normal;
    font-display: swap;
    src: local('SelfModernItalic'), url('{{ "SelfModernItalic.woff" | asset_url }}') format('woff');
  }

  @font-face {
    font-family: 'BasisGrotesqueProMono-Regular';
    font-style: normal;
    font-weight: normal;
    font-display: swap;
    src: local('BasisGrotesqueProMono-Regular'), url('{{ "BasisGrotesqueProMono-Regular.woff" | asset_url }}') format('woff');
  }

  @font-face {
    font-family: 'BasisGrotesquePro-Regular';
    font-style: normal;
    font-weight: normal;
    font-display: swap;
    {%- comment -%}
      bd v9o3 (2026-08-13) — WASTED PRELOAD + DUPLICATE DOWNLOAD.
      layout/theme.liquid preloads BasisGrotesquePro-Regular.woff2, but this src
      pointed at the .woff twin, so every uncached pageview fetched the font
      TWICE (14.1 KB preloaded-and-never-used + 16.0 KB actually used) and the
      preload bought nothing. woff2 first makes the preload land; the .woff stays
      as a second source for any browser without woff2 support (browsers download
      only the first supported format, so this is not a second request).
      MEASURED on the live sulfate article, interleaved A/B n=6/arm via HTML
      rewrite (scratchpad ab-inject.mjs, MODE=rewrite, chrome-headless-shell):
        before 6 font requests / 153.8 KB   after 5 requests / 138.0 KB
        Basis still active (document.fonts.check true), CLS 0.0296 -> 0.0297 (noise).
      Asset verified as a real woff2 (magic bytes wOF2), not a mislabelled woff.
    {%- endcomment -%}
    src: local('BasisGrotesquePro-Regular'),
         url('{{ "BasisGrotesquePro-Regular.woff2" | asset_url }}') format('woff2'),
         url('{{ "BasisGrotesquePro-Regular.woff" | asset_url }}') format('woff');
  }

  @font-face {
    font-family: 'BasisGrotesquePro-Bold';
    font-style: normal;
    font-weight: normal;
    font-display: swap;
    src: local('BasisGrotesquePro-Bold'), url('{{ "BasisGrotesquePro-Bold.woff" | asset_url }}') format('woff');
  }

  @font-face {
    font-family: 'BasisGrotesquePro-Black';
    font-style: normal;
    font-weight: normal;
    font-display: swap;
    src: local('BasisGrotesquePro-Black'), url('{{ "BasisGrotesquePro-Black.woff" | asset_url }}') format('woff');
  }

  @font-face {
    font-family: 'BasisGrotesquePro-Medium';
    font-style: normal;
    font-weight: normal;
    font-display: swap;
    src: local('BasisGrotesquePro-Medium'), url('{{ "BasisGrotesquePro-Medium.woff" | asset_url }}') format('woff');
  }

  @font-face {
    font-family: 'FontAwesome5Brands-Regular-400';
    font-style: normal;
    font-weight: normal;
    font-display: swap;
    src: local('FontAwesome5Brands-Regular-400'), url('{{ "FontAwesome5Brands-Regular-400.woff" | asset_url }}') format('woff');
  }
{% endstyle %}
