{%- comment -%}
  MIGRATION-DEBT: bd 62z. Bespoke Pipeline 6 telemetry for the custom Vertex
  rec engine — no Shopify app or theme setting covers first-party attribution
  for a self-built recommendation system, so this can't be a no-op. Port to
  OS 2.0: copy as-is (plain DOM + fetch/sendBeacon, zero P6-specific coupling)
  plus the two render-call sites (layout/theme.liquid, once) and the shop
  metafields (vertex.seo_platform_base/slug). Easy port. See
  os2-migration/customization-audit.md.

  Vertex rec widget instrumentation — fires impression + click events to the
  seo-platform dashboard's /vertex/events endpoint.

  Render this snippet once per page (it self-guards against double init).
  It auto-discovers any `[data-vertex-widget-id]` element on the page and:
    - fires ONE `vertex-rec-impression` event per widget (deferred via
      requestIdleCallback, so zero TBT impact)
    - adds a delegated click listener that fires `vertex-rec-click` on
      any product link inside a widget

  Each production widget snippet should set, on its outer `<section>`:
    data-vertex-widget-id="pdp-fbt|cart-routine|homepage-trending|collection-trending"
    data-vertex-placement="pdp|cart|homepage|collection"
    data-vertex-anchor-product-id="<id>"   (PDP only)
    data-vertex-products="id1,id2,..."     (the rec IDs shown)

  Config: SEO_PLATFORM_BASE + SEO_PLATFORM_SLUG should match the values in
  the Custom Pixel.
{%- endcomment -%}

<script>
(function () {
  if (window.__vertexRecsInstrumented) return;
  window.__vertexRecsInstrumented = true;

  var SEO_BASE = "{{ shop.metafields.vertex.seo_platform_base.value | default: '' }}";
  var SLUG     = "{{ shop.metafields.vertex.seo_platform_slug.value | default: '' }}";
  if (!SEO_BASE || !SLUG) return;
  // bd 62z (2026-07-18/19): NO /api prefix. Confirmed against seo-platform's
  // actual FastAPI route registration (api/app/routes/vertex.py:92,
  // router = APIRouter(prefix="/businesses/{slug}/vertex"), included with no
  // app-level prefix) and against the live Custom Pixel's own endpoint
  // construction (event-pixel/vertex-custom-pixel.js:120), which explicitly
  // documents the /api prefix was REMOVED after the 2026-05-19 Railway
  // migration to hit FastAPI directly. This snippet had never been deployed,
  // so the stale pre-migration /api/... path was never caught. Live-verified:
  // POST to the corrected URL with this exact payload shape returns 204.
  var ENDPOINT = SEO_BASE.replace(/\/+$/, "") + "/businesses/" + SLUG + "/vertex/events";

  function getVisitorId() {
    var m = (document.cookie || "").match(/(?:^|;\s*)_shopify_y=([^;]+)/);
    if (m) return decodeURIComponent(m[1]);
    var s = window.localStorage && localStorage.getItem("__vertex_vid");
    if (s) return s;
    var n = "anon-" + Math.random().toString(36).slice(2) + "-" + Date.now();
    try { localStorage.setItem("__vertex_vid", n); } catch (_) {}
    return n;
  }

  function nowIso() { return new Date().toISOString(); }

  // bd 62z fix (2026-08-05): content-type is DELIBERATELY text/plain, not
  // application/json — do not "correct" it back.
  //
  // application/json makes this a CORS non-simple request, so the browser
  // fires an OPTIONS preflight first. seo-platform's API sets
  // allow_origins=[settings.app_url] (the dashboard origin only), so the
  // preflight from hairmnl.com returns 400 with no
  // access-control-allow-origin — and the real POST is never sent. Because
  // sendBeacon returns true on *queueing*, this failed 100% SILENTLY: every
  // rec impression/click was dropped from the moment this snippet shipped
  // (2026-07-19) until this fix. Verified live: OPTIONS from
  // https://www.hairmnl.com -> 400, no ACAO header.
  //
  // text/plain is one of the three CORS-safelisted request content types,
  // which makes this a *simple* request: no preflight, browser sends it,
  // server receives it. The response is opaque to us, which is fine —
  // sendBeacon is fire-and-forget and never reads it.
  //
  // Safe server-side because the endpoint parses the RAW BODY and ignores
  // Content-Type entirely: api/app/routes/vertex.py does
  // `VertexEventBatchIn.model_validate_json(await request.body())`.
  // Verified live: POST with Content-Type: text/plain -> 204.
  //
  // The original 62z "verification" missed this because it interception-
  // tested sendBeacon (proving the CALL was made) and separately curled the
  // endpoint (curl is not subject to CORS) — never the actual browser->server
  // hop. Verify transport changes with a real browser request, not a curl.
  function send(events) {
    if (!events.length) return;
    try {
      var body = JSON.stringify({ events: events });
      if (navigator.sendBeacon) {
        navigator.sendBeacon(ENDPOINT, new Blob([body], { type: "text/plain" }));
        return;
      }
      // Same reasoning for the fallback: in mode:"no-cors" only safelisted
      // request headers survive, so an application/json Content-Type would
      // be stripped or reject the request.
      fetch(ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "text/plain" },
        body: body, keepalive: true, mode: "no-cors",
      }).catch(function () {});
    } catch (_) {}
  }

  function fireImpressions() {
    var widgets = document.querySelectorAll("[data-vertex-widget-id]");
    if (!widgets.length) return;
    var visitorId = getVisitorId();
    var events = [];
    var ts = nowIso();
    for (var i = 0; i < widgets.length; i++) {
      var el = widgets[i];
      var widgetId = el.getAttribute("data-vertex-widget-id");
      var placement = el.getAttribute("data-vertex-placement") || null;
      var anchor = el.getAttribute("data-vertex-anchor-product-id") || null;
      var products = (el.getAttribute("data-vertex-products") || "")
        .split(",").map(function (s) { return s.trim(); }).filter(Boolean);
      // 2026-08-05 (bd q9z6 item 4): handles ride alongside ids, positionally
      // aligned (vertex-recommendations.liquid appends to both CSVs in the same
      // post-filter branch). product_id stays the numeric join key; the handle is
      // carried in metadata so the dashboard has a human-readable label without
      // needing a product catalog or a Shopify API call. Guarded by index because
      // an older cached page may render data-vertex-products WITHOUT the new
      // data-vertex-handles attribute — in that case handle is simply omitted.
      var handles = (el.getAttribute("data-vertex-handles") || "")
        .split(",").map(function (s) { return s.trim(); }).filter(Boolean);
      // Emit one impression event per product so per-product analytics work
      for (var j = 0; j < products.length; j++) {
        var meta = { position: j };
        if (handles[j]) meta.handle = handles[j];
        events.push({
          event_type: "vertex-rec-impression",
          visitor_id: visitorId,
          occurred_at: ts,
          product_id: products[j],
          widget_id: widgetId,
          placement: placement,
          anchor_product_id: anchor,
          metadata: meta,
        });
      }
    }
    send(events);
  }

  function attachClickHandler() {
    document.addEventListener("click", function (e) {
      var link = e.target && e.target.closest && e.target.closest("a[href]");
      if (!link) return;
      var widget = link.closest("[data-vertex-widget-id]");
      if (!widget) return;
      var widgetId = widget.getAttribute("data-vertex-widget-id");
      var placement = widget.getAttribute("data-vertex-placement") || null;
      var anchor = widget.getAttribute("data-vertex-anchor-product-id") || null;
      // Product id resolution (2026-08-05 fix): the id attribute lives on the
      // CARD WRAPPER (<div class="vrec-card" data-vertex-product-id="...">,
      // see vertex-rec-card.liquid) — NOT on the <a>, which product-grid-item
      // renders without it. The original code read it off the link only, so
      // it ALWAYS fell through to href-parsing and reported the product
      // HANDLE — while impressions report numeric IDs from
      // data-vertex-products. Result: the dashboard's per-product table
      // bifurcated (impression rows keyed by numeric id with 0 clicks; click
      // rows keyed by handle with 0 impressions) and per-product CTR was
      // unmeasurable. Walk up to the nearest carrier of the attribute so
      // clicks report the SAME numeric id as impressions. Href-parsing stays
      // as a last-resort fallback (its handle is still better than null, and
      // handles >80 chars get truncated by the server column anyway — one
      // more reason numeric ids are the right key).
      // Scope to .vrec-card specifically: the widget <section> ALSO carries
      // data-vertex-product-id (the ANCHOR product's id) — a bare
      // closest("[data-vertex-product-id]") on a non-card link (heading,
      // view-all) would walk past the card level and mis-attribute the
      // click to the anchor product.
      var idCarrier = link.closest(".vrec-card[data-vertex-product-id]");
      var productId = (idCarrier && idCarrier.getAttribute("data-vertex-product-id")) ||
                      link.getAttribute("data-vertex-product-id");
      // The href always carries the handle — capture it regardless of whether
      // productId resolved, so clicks carry the same metadata.handle that
      // impressions now do (bd q9z6 item 4). This is also what lets the
      // dashboard reconcile the LEGACY handle-keyed click rows (logged before
      // the 2026-08-05 identifier fix) against numeric impression rows.
      var hrefMatch = (link.getAttribute("href") || "").match(/\/products\/([^/?#]+)/);
      var clickHandle = hrefMatch ? hrefMatch[1] : null;
      if (!productId) {
        productId = clickHandle;
      }
      send([{
        event_type: "vertex-rec-click",
        visitor_id: getVisitorId(),
        occurred_at: nowIso(),
        product_id: productId,
        widget_id: widgetId,
        placement: placement,
        anchor_product_id: anchor,
        metadata: clickHandle ? { handle: clickHandle } : {},
      }]);
    }, true);
  }

  function init() {
    attachClickHandler();
    if (window.requestIdleCallback) {
      window.requestIdleCallback(fireImpressions, { timeout: 2000 });
    } else {
      setTimeout(fireImpressions, 0);
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
</script>
