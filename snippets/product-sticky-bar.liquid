{%- comment -%}
  Sticky purchase bar — desktop (top-docked) + mobile (bottom-docked).

  Two modes:
  - PDP mode (default): appears when the main purchase-action block
    (.product__submit__buttons — ATC + notify + payment buttons) fully
    leaves the viewport; hides whenever any part of it is visible.
    IntersectionObserver on the CONTAINER, not the button — the OOS
    state swaps buttons via display, and a display:none button never
    "intersects", which made the bar show at the top of the page
    (operator spec 2026-08-12, bd pic6 Phase 1).
  - Collection mode (is_collection=true): always-visible on collection
    + brand pages (full STKY app replacement). Per bd a7av.8. JS
    hydrates the bar with the last-viewed product from sessionStorage
    if present; otherwise keeps the server-rendered first-product
    fallback. Card clicks on the collection page update the bar
    in-place via the JS in assets/hairmnl-common.js.

  OOS behaviour (bd pic6 Phase 2+3): syncs on theme:variant:change
  (the event Pipeline actually fires — the old variant:change listener
  never received anything). In-stock variant: qty + ATC. OOS variant:
  qty hidden, ATC swapped for the brand-brown NOTIFY ME WHEN AVAILABLE
  ([data-notify-trigger]) which opens the same BIS modal as the main
  PDP button via the delegated handler in assets/notify-when-available.js.

  Arguments:
    product       {Product}  required — what to render on first paint
    is_collection {Boolean}  optional, default false — switch to
                  collection always-visible mode

  CSS in snippets/css-overrides.liquid (generated — edit
  os2-migration/css-overrides.source.liquid and rebuild).
{%- endcomment -%}

{%- comment -%}
  bd pic6: selected_or_first_available_variant (was first_available_variant)
  so a ?variant= deep link to an OOS variant renders the bar in the same
  OOS state as the main form on first paint.
{%- endcomment -%}
{%- liquid
  assign first_variant = product.selected_or_first_available_variant
  if first_variant == nil
    assign first_variant = product.variants.first
  endif
  assign thumb_img = product.featured_media.preview_image
  assign is_collection_mode = is_collection | default: false
-%}

{%- if product != blank -%}
  <div class="vrec-product-sticky-bar{% if is_collection_mode %} vrec-product-sticky-bar--always-visible is-visible{% endif %}{% unless is_collection_mode or first_variant.available %} vrec-product-sticky-bar--oos{% endunless %}"
       id="vrec-product-sticky-bar"
       data-product-id="{{ product.id }}"
       data-product-handle="{{ product.handle }}"
       data-product-url="{{ product.url }}"
       data-vrec-sticky-mode="{% if is_collection_mode %}collection{% else %}pdp{% endif %}"
       aria-hidden="{% if is_collection_mode %}false{% else %}true{% endif %}">
    {%- if thumb_img -%}
      <div class="vrec-product-sticky-bar__thumb">
        <img src="{{ thumb_img | image_url: width: 96 }}"
             alt=""
             width="48"
             height="48"
             loading="lazy">
      </div>
    {%- endif -%}
    <div class="vrec-product-sticky-bar__info">
      <p class="vrec-product-sticky-bar__title">{{ product.title | strip_html }}</p>
      {%- comment -%} J11 S11 (bd a7av.22): the meta line is now the Judge.me star
          rating + review count (was the vendor — web-team ask). Same badge source
          as the product cards. Collection mode was removed in a7av.17. {%- endcomment -%}
      <div class="vrec-product-sticky-bar__meta vrec-product-sticky-bar__rating">
        {%- render 'judgeme_widgets', widget_type: 'judgeme_preview_badge', jm_style: '', concierge_install: true, product: product -%}
      </div>
    </div>
    <p class="vrec-product-sticky-bar__price" data-vrec-sticky-price>{{ first_variant.price | money }}</p>
    {%- form 'product', product, class: 'vrec-product-sticky-bar__form' -%}
      {%- comment -%} bd a7av.11: PDP mode gets in-bar variant <select> + qty input
          (STKY parity, decision 4). Collection mode keeps the simple hidden id +
          qty=1 — the collection bar's product is swapped in-place by
          assets/hairmnl-common.js on card-click, which rewrites only title/price/
          thumb/id and can't rebuild a <select>, so collection mode stays a
          single-variant quick-add. {%- endcomment -%}
      {%- if is_collection_mode -%}
        <input type="hidden" name="id" value="{{ first_variant.id }}" data-vrec-sticky-id>
        <input type="hidden" name="quantity" value="1">
      {%- else -%}
        {%- if product.variants.size > 1 -%}
          <select name="id"
                  class="vrec-product-sticky-bar__variant"
                  data-vrec-sticky-id
                  data-vrec-sticky-variant-select
                  aria-label="{{ 'products.product.variants' | t | default: 'Variant' }}">
            {%- for v in product.variants -%}
              <option value="{{ v.id }}"
                      data-price="{{ v.price }}"
                      data-available="{{ v.available }}"
                      {% if v.id == first_variant.id %}selected{% endif %}
                      {% unless v.available %}disabled{% endunless %}>{{ v.title }}{% unless v.available %} — {{ 'products.product.sold_out' | t | default: 'Sold out' }}{% endunless %}</option>
            {%- endfor -%}
          </select>
        {%- else -%}
          <input type="hidden" name="id" value="{{ first_variant.id }}" data-vrec-sticky-id>
        {%- endif -%}
        <input type="number"
               name="quantity"
               value="1"
               min="1"
               inputmode="numeric"
               class="vrec-product-sticky-bar__qty"
               data-vrec-sticky-qty
               aria-label="{{ 'products.product.quantity' | t | default: 'Quantity' }}">
      {%- endif -%}
      {%- comment -%} bd a7av.15: Skip to Checkout (STKY parity). When the theme
          setting Cart → "Skip to checkout from the sticky bar" is on, the button
          becomes "Buy it now" + data-vrec-checkout — a global handler in
          hairmnl-common.js adds the selected variant+qty then redirects to
          /checkout. The native submit (add to cart) is the JS-off fallback. {%- endcomment -%}
      <button type="submit"
              name="add"
              class="vrec-product-sticky-bar__cta"
              data-vrec-sticky-atc
              {% if settings.sticky_atc_skip_to_checkout %}data-vrec-checkout{% endif %}
              {% unless first_variant.available %}disabled aria-disabled="true"{% endunless %}>
        {%- if first_variant.available -%}
          {%- if settings.sticky_atc_skip_to_checkout -%}
            {{ 'products.product.buy_now' | t | default: 'Buy it now' }}
          {%- else -%}
            {{ 'products.product.add_to_cart' | t | default: 'Add to cart' }}
          {%- endif -%}
        {%- else -%}
          {{ 'products.product.sold_out' | t | default: 'Sold out' }}
        {%- endif -%}
      </button>
      {%- unless is_collection_mode -%}
        {%- comment -%} bd pic6 Phase 3: OOS CTA. Carries [data-notify-trigger]
            so the delegated click handler in assets/notify-when-available.js
            opens the SAME BIS modal as the main PDP button. That JS also owns
            this button's hidden attr + data-variant-* refresh on every
            theme:variant:change (it updates ALL [data-notify-trigger] nodes),
            so the bar and the main form can never disagree. Shown/hidden
            layout (qty removal, full-width on mobile) is CSS driven by the
            bar's --oos class. Brown mirrors the main .btn--notify:
            var(---color-primary) with the g1n.12 measured fallback #AC604F. {%- endcomment -%}
        <button type="button"
                class="vrec-product-sticky-bar__notify"
                data-vrec-sticky-notify
                data-notify-trigger
                data-variant-id="{{ first_variant.id }}"
                data-sku="{{ first_variant.sku | escape }}"
                data-product-title="{{ product.title | escape }}"
                data-variant-title="{{ first_variant.title | escape }}"
                {% if first_variant.available %}hidden{% endif %}>
          {{ 'products.product.notify_when_available' | t | default: 'Notify me when available' }}
        </button>
      {%- endunless -%}
    {%- endform -%}
  </div>

  <script>
    (function () {
      // bd a7av.9: previously desktop-only. The native bar now also runs on
      // mobile (STKY mobile-bar parity) — the PDP-mode IntersectionObserver
      // below shows it when the primary ATC scrolls out, on all viewports.
      // Mobile presentation (bottom-fixed + safe-area, Reamaze coexistence) is
      // handled in css-overrides.liquid's @media (max-width:1023px) block.
      var bar = document.getElementById('vrec-product-sticky-bar');
      if (!bar) return;

      // Collection mode skips the IntersectionObserver — bar is always visible.
      // Hydration + card-click updates handled in assets/hairmnl-common.js.
      var mode = bar.getAttribute('data-vrec-sticky-mode');
      if (mode === 'collection') {
        // Track PDP-visit on PDP entry doesn't apply here (no product page-view
        // on collection pages). hairmnl-common.js does the hydration work.
        return;
      }

      // bd pic6 Phase 1: observe the purchase-action CONTAINER, not the ATC
      // button. The OOS state swaps ATC/notify via display:none, and a
      // display:none element never intersects — observing the button made the
      // bar show while the visible NOTIFY block was on screen. The container
      // (.product__submit__buttons wraps ATC + notify + payment buttons) stays
      // laid out in every state. Fallbacks keep old behaviour if the theme
      // markup changes.
      var targets = document.querySelectorAll('.product__submit__buttons');
      if (!targets.length) {
        targets = document.querySelectorAll('form[action*="/cart/add"]:not(.vrec-product-sticky-bar__form)');
      }
      if (!targets.length) {
        targets = document.querySelectorAll(
          'form[action*="/cart/add"]:not(.vrec-product-sticky-bar__form) button[name="add"], ' +
          'form[action*="/cart/add"]:not(.vrec-product-sticky-bar__form) input[name="add"]'
        );
      }
      if (!targets.length) return;

      // bd pic6 Phase 1 (desktop docking): the bar top-docks below the sticky
      // header. The old hardcoded top:70px overlapped the taller stuck header
      // and its dropdowns. Measure the real header bottom edge and publish it
      // as --vrec-sticky-top; CSS falls back to 70px if JS never runs.
      var headerEl = document.querySelector('.theme__header');
      function dockBelowHeader() {
        if (!headerEl || !window.matchMedia('(min-width: 1024px)').matches) return;
        var b = headerEl.getBoundingClientRect().bottom;
        bar.style.setProperty('--vrec-sticky-top', Math.max(0, Math.round(b)) + 'px');
      }

      // Hide the bar if ANY observed action container is visible (threshold 0
      // = shows only once the block has completely left the viewport).
      var visibleMap = new Map();
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          visibleMap.set(entry.target, entry.isIntersecting);
        });
        var anyVisible = false;
        visibleMap.forEach(function (v) { if (v) anyVisible = true; });
        if (anyVisible) {
          bar.classList.remove('is-visible');
          bar.setAttribute('aria-hidden', 'true');
        } else {
          dockBelowHeader();
          bar.classList.add('is-visible');
          bar.setAttribute('aria-hidden', 'false');
        }
      }, { rootMargin: '0px 0px 0px 0px', threshold: 0 });
      targets.forEach(function (t) { io.observe(t); });

      var dockTimer = null;
      window.addEventListener('resize', function () {
        if (dockTimer) window.clearTimeout(dockTimer);
        dockTimer = window.setTimeout(dockBelowHeader, 150);
      });

      // PDP mode also writes to sessionStorage so the collection-mode bar can
      // hydrate to "last viewed product" on subsequent collection navigation.
      try {
        var sessionPayload = {
          id: bar.getAttribute('data-product-id'),
          handle: bar.getAttribute('data-product-handle'),
          url: bar.getAttribute('data-product-url'),
          title: bar.querySelector('.vrec-product-sticky-bar__title')?.textContent || '',
          price_html: bar.querySelector('.vrec-product-sticky-bar__price')?.innerHTML || '',
          thumb_src: bar.querySelector('.vrec-product-sticky-bar__thumb img')?.src || '',
          variant_id: bar.querySelector('[data-vrec-sticky-id]')?.value || '',
          variant_label: bar.querySelector('[data-vrec-sticky-variant]')?.textContent || '',
          available: !bar.querySelector('.vrec-product-sticky-bar__cta')?.disabled,
          ts: Date.now()
        };
        sessionStorage.setItem('hairmnl_last_viewed_product', JSON.stringify(sessionPayload));
      } catch (e) { /* sessionStorage disabled — silent no-op */ }

      // bd pic6 Phase 2: sync on `theme:variant:change` — the event Pipeline's
      // theme.js actually dispatches (assets/notify-when-available.js consumes
      // the same one). The old listener waited on `variant:change`, which
      // nothing fires, so the bar froze on its server-rendered defaults.
      // e.detail.variant is null when the chosen option combination doesn't
      // exist — handled without touching the last-good display.
      function formatCents(p) {
        return typeof p === 'string' ? p : (p / 100).toLocaleString('en-PH', { style: 'currency', currency: 'PHP' });
      }
      function setBarOOS(oos) {
        bar.classList.toggle('vrec-product-sticky-bar--oos', oos);
      }
      document.addEventListener('theme:variant:change', function (e) {
        var variant = e && e.detail ? e.detail.variant : null;
        var atcBtn = bar.querySelector('[data-vrec-sticky-atc]');
        if (!variant) {
          // Unavailable combination: nothing purchasable, nothing to notify on.
          // Disable the CTA; notify stays hidden (notify-when-available.js only
          // un-hides it for a real OOS variant).
          if (atcBtn) atcBtn.disabled = true;
          return;
        }
        var idInput = bar.querySelector('[data-vrec-sticky-id]');
        var priceEl = bar.querySelector('[data-vrec-sticky-price]');
        var variantEl = bar.querySelector('[data-vrec-sticky-variant]');
        if (idInput && variant.id) idInput.value = variant.id;   // <select> or hidden input — both take .value
        if (priceEl && variant.price != null) priceEl.textContent = formatCents(variant.price);
        if (variantEl && variant.title) variantEl.textContent = variant.title;
        var oos = variant.available === false;
        setBarOOS(oos);
        if (atcBtn) atcBtn.disabled = oos;
        // Phase 3: the bar's [data-notify-trigger] hidden state + data-variant-*
        // attrs are refreshed globally by notify-when-available.js on this same
        // event — no duplicate bookkeeping here.
      });

      // bd a7av.11: in-bar variant <select> (PDP parity with STKY). When the
      // shopper changes the variant directly in the bar, update the visible price
      // + CTA availability. The <select name="id"> posts the chosen variant
      // natively on submit; this listener only keeps the display in sync.
      var barSelect = bar.querySelector('[data-vrec-sticky-variant-select]');
      if (barSelect) {
        barSelect.addEventListener('change', function () {
          var opt = barSelect.options[barSelect.selectedIndex];
          if (!opt) return;
          var priceEl = bar.querySelector('[data-vrec-sticky-price]');
          var cents = parseInt(opt.getAttribute('data-price'), 10);
          if (priceEl && !isNaN(cents)) {
            priceEl.textContent = formatCents(cents);
          }
          var available = (opt.getAttribute('data-available') === 'true');
          var btn = bar.querySelector('[data-vrec-sticky-atc]');
          if (btn) btn.disabled = !available;
          // bd pic6: an in-bar pick is always an available option (OOS options
          // are disabled in the <select>), so it exits the OOS layout the main
          // picker may have put the bar into.
          setBarOOS(!available);
        });
      }

      // J11 S9 (bd a7av.20, P1): the bar's native form submit navigated the shopper
      // off the PDP (Shopify's add-form redirect). Intercept and add via AJAX —
      // same flow as the [data-vrec-add] handler in hairmnl-common.js §10: POST
      // /cart/add.js, refresh the header count from /cart.js, then hand off to the
      // theme's drawer (theme:cart:popdown + theme:cart:change). The native submit
      // remains the JS-off fallback. Skip-to-checkout (data-vrec-checkout) keeps
      // its own click handler — when the setting is on, this submit path is skipped.
      var barForm = bar.querySelector('form');
      if (barForm) {
        barForm.addEventListener('submit', function (e) {
          var cta = barForm.querySelector('.vrec-product-sticky-bar__cta');
          if (cta && cta.hasAttribute('data-vrec-checkout')) return; // buy-now flow owns this click
          e.preventDefault();
          if (cta && cta.getAttribute('aria-busy') === 'true') return;
          var idEl = barForm.querySelector('[name="id"]');
          var qtyEl = barForm.querySelector('[name="quantity"]');
          var qty = (qtyEl && parseInt(qtyEl.value, 10) > 0) ? parseInt(qtyEl.value, 10) : 1;
          if (!idEl || !idEl.value) return;
          if (cta) { cta.setAttribute('aria-busy', 'true'); cta.disabled = true; }
          fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ id: idEl.value, quantity: qty })
          })
            .then(function (r) { if (!r.ok) throw new Error('add failed: ' + r.status); return r.json(); })
            .then(function () {
              return fetch('/cart.js', { headers: { 'Accept': 'application/json' } })
                .then(function (r) { return r.json(); })
                .then(function (cart) {
                  var countEl = document.querySelector('[data-header-cart-count]');
                  if (countEl) {
                    countEl.setAttribute('data-header-cart-count', cart.item_count);
                    countEl.textContent = '(' + cart.item_count + ')';
                  }
                  // J30 (bd 2i8b.83): theme.js listeners read e.detail.cart —
                  // dispatching without detail threw TypeErrors and left the
                  // drawer/header stale. Pass the fresh /cart.js response.
                  document.dispatchEvent(new CustomEvent('theme:cart:popdown', { bubbles: true, detail: { cart: cart } }));
                  document.dispatchEvent(new CustomEvent('theme:cart:change', { bubbles: true, detail: { cart: cart } }));
                });
            })
            .catch(function (err) {
              if (window.console && console.warn) console.warn('[sticky-bar-add]', err && err.message ? err.message : err);
            })
            .then(function () {
              if (cta) { cta.removeAttribute('aria-busy'); cta.disabled = false; }
            });
        });
      }
    })();
  </script>
{%- endif -%}
