{%- comment -%}
  bd nlr8 (2026-08-05) — DORMANT SECTION with a KNOWN POSITIONING DEFECT if wired up.

  Reachability: referenced by ZERO template JSON / .liquid files. Live /pages/reviews contains none
  of this markup (`swiper-container`, `custom-banner`, `brand-banner-slider` all count 0). BUT this
  section DOES ship a `presets` block, so it is one theme-editor click from being live — unlike its
  sibling in sections/collection-branded.liquid.

  THE DEFECT: the markup below uses the Swiper v5 container class `.swiper-container`, while this
  theme ships Swiper v6+ CSS keyed on `.swiper` (critical-css.liquid has
  `.swiper{position:relative;overflow:hidden;...}`). The only `.swiper-container` position rule in
  the theme is `.cross-post-blogs .swiper-container` (assets/custom-theme-core.css:1118), which does
  not match here. So the container is never positioned and
  `.swiper-button-*{position:absolute;top:50%}` resolves against the INITIAL CONTAINING BLOCK —
  arrows at 50% of the viewport, permanently.

  CAUTION on the obvious one-token fix: adding `swiper` to the container class also pulls in
  `.swiper{width:100%;height:100%}` from critical CSS, which can collapse the container when the
  parent has no height. That is why this was NOT auto-fixed — verify visually on a duplicate theme
  before shipping any change here.
{%- endcomment -%}
{% if page.handle  == 'reviews' %}
 <div class="custom-banner swiper-container" style="text-align: center !important; margin-top: 20px !important;">
              <!-- Additional required wrapper -->
              <div class="swiper-wrapper">
                  <!-- Slides -->
                  {% for block in section.blocks limit: section.blocks.size %}
                	<div class="swiper-slide">
                      <a href="{{block.settings.slide_image_url}}">
                        <picture>
                          <source media="(min-width: 1009px)" srcset="{{ block.settings.slide_image_desktop | image_url: height: 788 }}">
                          <img class="banner-slide-img" src="{{ block.settings.slide_image_mobile | image_url: height: 502 }}" loading="lazy" alt="Banner Slide 1">
                        </picture>
                      </a>
                    </div>
                  {% endfor %}
              </div>
              <!-- If we need pagination -->
              <div class="custom-banner swiper-pagination"></div>
              <div class="custom-banner swiper-button-next"></div>
              <div class="custom-banner swiper-button-prev"></div>
            </div>

<style>
  .custom-banner {
    margin-bottom: 30px;
  }
</style>

<script>
  var customBannerSlider = new Swiper ('.custom-banner.swiper-container', {
    direction: 'horizontal',
    autoplay: {
      delay: {{section.settings.slide_delay}},
    },
    loop: true,
    pagination: {
      el: '.custom-banner.swiper-pagination',
      dynamicBullets: true,
      clickable: true
    },
    navigation: {
      nextEl: '.custom-banner.swiper-button-next',
      prevEl: '.custom-banner.swiper-button-prev',
    },
  })
  
</script>
{% endif %}

{% schema %}
{
  "name": "Brand Banner Slider",
  "class": "brand-banner-slider",
  "max_blocks": 10,
  "settings": [
	{
      "type": "checkbox",
      "id": "enable_section",
      "label": "Enable Section",
      "default": false
    },
	{
      "type":    "range",
      "id":      "section_margin_top",
      "min":     0,
      "max":     100,
      "step":    1,
      "label":   "Section margin top",
      "default": 20
    },
	{
      "type":    "range",
      "id":      "section_margin_bottom",
      "min":     0,
      "max":     100,
      "step":    1,
      "label":   "Section margin bottom",
      "default": 20
    },
    {
      "type":    "range",
      "id":      "slide_delay",
      "min":     1000,
      "max":     5000,
      "step":    1000,
      "label":   "Slide delay",
      "info": "Slide delay uses milliseconds, so 1 second is equal to 1000",
      "default": 3000
    }
  ],
  "blocks": [
	{
      "type": "banner_slide",
      "name": "Banner Slide",
	  "settings": [
        {
          "type": "image_picker",
          "id": "slide_image_desktop",
          "label": "Banner Slide Image (Desktop)",
          "info": "1400px width x 788px height recommended"
        },
        {
          "type": "image_picker",
          "id": "slide_image_mobile",
          "label": "Banner Slide Image (Mobile)",
          "info": "552px width x 502px height recommended"
        },
        {
          "type": "url",
          "id": "slide_image_url",
          "label": "Banner Slide URL"
        }
	  ]
	}
  ],
  "presets": [
    {
      "name": "Brand Banner Slider",
	  "category": "Banners",
	  "blocks": [
		{
		  "type": "banner_slide"
		},
		{
		  "type": "banner_slide"
		}
	  ]
    }
  ]
}
{% endschema %}