#!/usr/bin/env bash
# Pre-push hook — enforces MIGRATION-CONTRACT.md.
#
# Install once per clone:
#   git config core.hooksPath .githooks
#
# What it checks:
#   1. scripts/check-snippet-wiring.py — catches TWO regression classes:
#      a) Dropped {% render '<snippet>' %} callsites (yxte 2026-05-18 AM)
#      b) Dropped {{ '<file>' | asset_url }} references (cache-shadow
#         2026-05-18 PM — see MIGRATION-CONTRACT.md Rule 9)
#
# To bypass for an emergency push (NOT RECOMMENDED — coordinator review required):
#   git push --no-verify
#
# But you should never need to. If the lint fails, fix the underlying issue.

set -euo pipefail

REPO="$(git rev-parse --show-toplevel)"

# 1) Snippet + asset wiring lint (both regression classes from 2026-05-18)
if [ -x "$REPO/scripts/check-snippet-wiring.py" ]; then
    echo "→ Running scripts/check-snippet-wiring.py …" >&2
    if ! python3 "$REPO/scripts/check-snippet-wiring.py" >&2; then
        echo "" >&2
        echo "✗ Pre-push: snippet/asset wiring lint failed." >&2
        echo "  See MIGRATION-CONTRACT.md Rules 1 + 9 for the rules." >&2
        echo "  Run locally for details: python3 scripts/check-snippet-wiring.py" >&2
        echo "  Modes: --snippets-only / --assets-only / --json / --verbose" >&2
        exit 1
    fi
fi

# 2) critical-CSS coverage lint (bd 958r.6) — catches first-paint geometry that depends on a
#    DEFERRED stylesheet. This is the class that produced three live CLS bugs on 2026-08-05
#    (dh8x / wscl / nahn.4). Mirrored locally as well as in CI because snippets/critical-css.liquid
#    ships straight to the LIVE theme — catching it here beats catching it after customers do.
if [ -x "$REPO/scripts/check-critical-css-coverage.py" ]; then
    echo "→ Running scripts/check-critical-css-coverage.py …" >&2
    if ! python3 "$REPO/scripts/check-critical-css-coverage.py" >&2; then
        echo "" >&2
        echo "✗ Pre-push: critical-CSS coverage lint failed." >&2
        echo "  A rule first paint needs lives only in a deferred sheet — this is the" >&2
        echo "  dh8x/wscl CLS class. See the docstring in the script for the mechanism." >&2
        exit 1
    fi
fi

# 3) css-overrides build sync (bd 958r.7) — snippets/css-overrides.liquid is GENERATED from
#    os2-migration/css-overrides.source.liquid. If someone edits the generated file directly, or
#    edits the source without rebuilding, the shipped CSS silently stops matching the documented
#    source. This is the guard against that.
if [ -x "$REPO/scripts/build-css-overrides.py" ]; then
    echo "→ Running scripts/build-css-overrides.py --check …" >&2
    if ! python3 "$REPO/scripts/build-css-overrides.py" --check >&2; then
        echo "" >&2
        echo "✗ Pre-push: css-overrides is out of sync with its source." >&2
        echo "  Edit os2-migration/css-overrides.source.liquid, then run:" >&2
        echo "    python3 scripts/build-css-overrides.py" >&2
        exit 1
    fi
fi

# Add additional checks here as the contract grows.
# Examples for future:
#   - scripts/check-overlay-css.py  (already runs in CI; could mirror locally)
#   - shopify theme check (Liquid lint)
#   - visual diff for refactor commits

exit 0
